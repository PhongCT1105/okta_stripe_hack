    "vercel-app": {
      "name": "vercel-app",
      "providerName": "Vercel",
      "serviceId": "project"
    },
    "vercel-plan": {
      "name": "vercel-plan",
      "providerName": "Vercel",
      "serviceId": "hobby"
    }
