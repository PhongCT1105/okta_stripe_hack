{
  "version": 1,
  "providers": {
    "auth0": {
      "name": "Auth0"
    },
    "neon": {
      "name": "Neon"
    },
    "openrouter": {
      "name": "OpenRouter"
    },
    "vercel": {
      "name": "Vercel"
    }
  },
  "resources": {
    "auth0-client": {
      "name": "auth0-client",
      "providerName": "Auth0",
      "serviceId": "client"
    },
    "auth0-plan": {
      "name": "auth0-plan",
      "providerName": "Auth0",
      "serviceId": "free"
    },
    "database": {
      "name": "database",
      "providerName": "Neon",
      "serviceId": "postgres"
    },
    "neon-plan": {
      "name": "neon-plan",
      "providerName": "Neon",
      "serviceId": "free"
