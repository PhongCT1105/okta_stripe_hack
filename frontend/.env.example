# Local development uses this value. Set the canonical HTTPS origin in
# production. Omit APP_BASE_URL in Vercel previews so Auth0 infers the request
# origin; each preview callback/logout origin must still be allowed in Auth0.
APP_BASE_URL=http://localhost:3000

# Server-only values. Configure all four together.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

ANTHROPIC_API_KEY=
